# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# editor — local settings only
.vscode/
/.vscode

# Cursor — commit shared rules; ignore local hooks
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# GitHub — commit CI workflows and contributor templates; ignore local hooks
.github/*
!.github/workflows/
!.github/workflows/**
!.github/ISSUE_TEMPLATE/
!.github/ISSUE_TEMPLATE/**
!.github/pull_request_template.md
!.github/dependabot.yml

# Impeccable (local design tool cache — do not commit)
.impeccable/

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cloudflare
.wrangler
.wrangler-dry

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin
.env

# local agent / report scratch
.claude/
posthog-error-tracking-report.md
