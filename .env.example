# Copy to .env.local for local testing.
#
# Hosting notes:
# - Vercel: set env vars in Project → Settings → Environment Variables
# - Cloudflare: this repo deploys as a Worker + static assets (see wrangler.toml),
#   not Cloudflare Pages. Use `npm run pages:deploy` after `npm run build`.
#   Set the same NEXT_PUBLIC_* vars in the Cloudflare dashboard for Production.
#
# Build:
#   Framework / preset: Next.js Static HTML Export (or equivalent)
#   Build command: npm run build
#   Output directory: out

# --- SEO (optional) ---
# Google Search Console verification token
GOOGLE_SITE_VERIFICATION=

# --- PostHog (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Optional first-party proxy (advanced — requires vercel.json rewrites on Vercel):
# NEXT_PUBLIC_POSTHOG_HOST=/ingest
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# --- Polar checkout overrides (optional) ---
# Defaults live in lib/site.ts. Set these only to override buy links at build time.
# NEXT_PUBLIC_POLAR_SILVER_CHECKOUT_URL=
# NEXT_PUBLIC_POLAR_GOLD_CHECKOUT_URL=
# NEXT_PUBLIC_POLAR_PLATINUM_CHECKOUT_URL=
# NEXT_PUBLIC_POLAR_SUPPORT_CHECKOUT_URL=
